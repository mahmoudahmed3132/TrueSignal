// truesignal-beacon-unknown-token: HMAC-valid token unknown to the Hub (medium). Respects the source lists.
// Elastic twin: Docs/siem/elastic/truesignal-beacon-unknown-token.json
// Schedule: every 5m over the last 6m.
event.module="truesignal" event.dataset="truesignal.alert"
| event.action="beacon_triggered" truesignal.details.beacon_known="false"
| truesignal.whitelisted!="true" truesignal.known_scanner!="true"
| table([@timestamp, host.name, source.ip, truesignal.details.token, truesignal.details.channel])
